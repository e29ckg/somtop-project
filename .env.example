# Copy to .env and set values for this machine. Never commit the real .env file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
DB_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:8099

# XAMPP deployment: edit these values in the real .env on each server.
# APP_URL is the browser URL; APP_BASE_PATH must match its path.
APP_URL=http://localhost:8099/somtop
APP_BASE_PATH=/somtop/
XAMPP_ROOT=C:/xampp
HOST=127.0.0.1
PORT=8088
APP_ENV=production
COOKIE_SECURE=false
COOKIE_PATH=/somtop
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=somtop_db
