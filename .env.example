# Copy to .env and set values for this machine. Never commit the real .env file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
DB_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost

# XAMPP deployment: edit these values in the real .env on each server.
# APP_URL is the browser URL; APP_BASE_PATH must match its path.
APP_URL=http://localhost/somtop
APP_BASE_PATH=/somtop/
XAMPP_ROOT=C:/xampp
APACHE_DOCUMENT_ROOT=C:/xampp/htdocs
HOST=127.0.0.1
PORT=8088
APP_ENV=production
COOKIE_SECURE=false
COOKIE_PATH=/somtop
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=somtop_db

# Allow admins to run the GitHub update from the production web app
ENABLE_WEB_UPDATE=false

# Optional Auth-Hub SSO alongside local login. Empty URL shows local login only.
# APP_URL must be the public browser URL (including /somtop when deployed).
AUTH_HUB_URL=
AUTH_HUB_CLIENT_ID=somtop
AUTH_HUB_SYSTEM_CODE=somtop
# Explicit mapping: immutable Auth-Hub user ID -> existing Somtop username.
# Example: AUTH_HUB_USER_MAP={"12":"admin","34":"court_user"}
AUTH_HUB_USER_MAP={}
